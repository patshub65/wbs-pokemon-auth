{
  "compilerOptions": {
    /* Base Options */
    "esModuleInterop": true,
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    /* Node Options */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "module": "preserve",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "dist",
    /* Paths */
    "paths": {
      "#*": [
        "./src/*"
      ],
      /* "#db": [
        "./src/db/index.ts"
      ],
      "#models": [
        "./src/models/index.ts"
      ],
      "#routes": [
        "./src/routes/index.ts"
      ],
      "#controllers": [
        "./src/controllers/index.ts"
      ],
      "#schemas": [
        "./src/schemas/index.ts"
      ] */
    }
  },
  "include": [
    "src"
  ]
}